{
  "name": "zhuju-luopan",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "传统人居环境方位参考工具（桌面端 / 微信小程序 / H5）",
  "author": "居境罗盘团队",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "scan": "node scripts/scan-compliance.mjs",
    "content": "node scripts/generate-content.mjs",
    "desktop:dev": "Desktop=1 DESKTOP_DEV_SERVER=http://localhost:5199 concurrently -k -s first \"vite -c desktop/vite.config.ts\" \"wait-on http://localhost:5199 && electron desktop/main.cjs\"",
    "desktop:web": "vite -c desktop/vite.config.ts",
    "desktop:build": "vite build -c desktop/vite.config.ts",
    "desktop:dist": "npm run desktop:build && electron-builder --config desktop/electron-builder.yml --mac",
    "desktop:typecheck": "vue-tsc -p tsconfig.desktop.json --noEmit",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029001",
    "@dcloudio/uni-components": "3.0.0-5030420261029001",
    "@dcloudio/uni-h5": "3.0.0-5030420261029001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029001",
    "lunar-javascript": "1.7.8",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029001",
    "@vitest/coverage-v8": "1.6.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^10.0.6",
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.3",
    "sass": "^1.107.0",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vitest": "1.6.1",
    "vue-tsc": "^2.0.29",
    "wait-on": "^9.5.1"
  }
}
